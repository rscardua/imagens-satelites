# Configuração do servidor de imagens (CBERS-4A / NASA GIBS).
# Copie para `.env` e ajuste. O server carrega `.env` automaticamente no startup
# (via dotenvy), procurando no diretório atual e ancestrais. Variáveis já definidas
# no ambiente têm precedência. Basta:
#   cd apps/server-rust && cargo run -p server

# --- Obrigatórias ---
IMAGERY_INPE_STAC_BASE_URL=https://data.inpe.br/bdc/stac/v1
IMAGERY_INPE_STAC_COLLECTIONS=CBERS-WFI-8D-1

# --- NASA GIBS (alternativa) ---
IMAGERY_NASA_GIBS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best
IMAGERY_NASA_GIBS_LAYER=VIIRS_NOAA20_CorrectedReflectance_TrueColor

# --- Comportamento de busca ---
IMAGERY_PROVIDER_TIMEOUT_SECS=8
IMAGERY_CACHE_TTL_SECS=60
IMAGERY_CACHE_CAPACITY=1024
IMAGERY_RESULT_LIMIT=50
IMAGERY_MAX_AREA_DEG2=4.0
IMAGERY_DEFAULT_WINDOW_DAYS=30
IMAGERY_VALIDATE_COLLECTIONS=true

# --- HTTP / observabilidade ---
HTTP_BIND_ADDR=127.0.0.1:8080
CORS_ALLOW_ORIGIN=*
RUST_LOG=info,imagery=debug,server=debug
